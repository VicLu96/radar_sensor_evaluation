/*
 * VL53L9CX time-of-flight sensor, for the bring-up test application.
 *
 * This is an APPLICATION overlay, not a board file. The board describes the
 * board; the sensor's configuration travels with the application that uses it,
 * and water_sense_board stays Victor's.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/ {
	aliases {
		tof0 = &tof;
	};
};

&i2c21 {
	/* Bus speed and pins come from the board file. 400 kHz there, which is
	 * ~404 ms for a full 54x42 frame and ~24 ms for the 12x10 this test
	 * uses.
	 */

	tof: vl53l9cx@29 {
		compatible = "st,vl53l9cx";
		status = "okay";

		/* 7-bit. ST's 0x52 is the 8-bit form; their own code shifts it
		 * down. See firmware/drivers/vl53l9cx/README.md.
		 */
		reg = <0x29>;

		/*
		 * ====================================================
		 * THESE TWO ARE PLACEHOLDERS AND MUST BE CONFIRMED
		 * ====================================================
		 * They are ST's reference values, not measurements of this
		 * board. vl53l9_init() writes both into the device, and a wrong
		 * value misconfigures the analogue front end rather than failing
		 * loudly — the sensor will answer and return plausible rubbish.
		 *
		 * The application prints both at startup so a wrong one is
		 * visible in the first lines of RTT output rather than being
		 * diagnosed later as a sensor fault.
		 */
		vdda-microvolt = <2800000>;   /* CONFIRM: 2800000 or 3300000 */
		vddio-microvolt = <1800000>;  /* CONFIRM: 1200000 or 1800000 */

		/* Not a placeholder. AP_CLK is 8 MHz from the GRTC fast clock
		 * output on P0.00, configured in the board file and running
		 * continuously. No `pwms` property here on purpose: the driver
		 * then treats the clock as board-supplied and does not try to
		 * gate it, which is correct — see docs/plan/ap-clk-always-on.md.
		 */
		ext-clock-frequency = <8000000>;

		/*
		 * xshut-gpios, int-gpios and power-gpios are all OMITTED,
		 * because their pins have not been given. The driver treats all
		 * three as optional, so this builds and runs — but know what is
		 * lost:
		 *
		 *   no xshut-gpios  -> no deterministic reset. The driver cannot
		 *                      power-cycle the sensor, so a device left
		 *                      in a bad state stays there until the
		 *                      board is power-cycled by hand.
		 *   no int-gpios    -> frame-ready is polled, which keeps the
		 *                      CPU awake across the integration time.
		 *                      Fine for a bench test, wrong for the
		 *                      energy work.
		 *   no power-gpios  -> the sensor domain is never dropped, so
		 *                      PM_DEVICE_ACTION_TURN_OFF does nothing
		 *                      and the multi-month battery claim has no
		 *                      mechanism behind it.
		 *
		 * Add them here — not in the board file — once the pins are
		 * known.
		 */

		/* Bytes per I2C write during the 9,865-byte blob upload. */
		blob-chunk-size = <1024>;
	};
};
