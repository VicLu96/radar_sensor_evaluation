/*
 * VL53L9CX time-of-flight sensor, for the bring-up test application.
 *
 * This is an APPLICATION overlay, not a board file. The board describes the
 * board; the sensor's configuration travels with the application that uses it,
 * and water_sense_board stays Victor's.
 *
 * All values below are Victor's, confirmed 2026-09-04. Nothing here is a
 * placeholder any more.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	aliases {
		tof0 = &tof;
	};
};

&i2c21 {
	/*
	 * The firmware patch upload could never have worked without these.
	 *
	 * The platform layer writes the 16-bit register index and the payload as
	 * two i2c_msg entries, where only the second carries I2C_MSG_STOP. That
	 * is the correct Zephyr idiom for one START..STOP transaction, and it is
	 * exactly the pattern i2c_nrfx_twim.c:95 detects as "merge these", which
	 * routes both through an internal buffer capped at
	 * MAX(zephyr,concat-buf-size, zephyr,flash-buf-max-size).
	 *
	 * Both default to 16 bytes (nordic,nrf-twim.yaml:31,45). With
	 * blob-chunk-size = 1024 each chunk asks for 2 + 1024 = 1026, so every
	 * attempt returned -ENOSPC.
	 *
	 * A second, independent reason for the same failure: g_vl53l9_fw_patch is
	 * `const`, so it links into RRAM (verified: 0x0000d0dc, section R) and
	 * TWIM EasyDMA cannot source from there. nrf_dma_accessible_check() fails
	 * and forces the same buffer even without concatenation. That is what
	 * zephyr,flash-buf-max-size exists for, which is why both are set.
	 *
	 * The two share the same RAM and the driver takes the max, so this costs
	 * 1040 bytes once, not twice.
	 *
	 * Found 2026-09-06 by two independent expert reviews. It was invisible
	 * because the sensor has never got far enough to attempt the upload, and
	 * because device_boot() was discarding vl53l9_init()'s return code.
	 */
	zephyr,concat-buf-size = <1040>;
	zephyr,flash-buf-max-size = <1040>;

	/* Bus speed and pins come from the board file: 400 kHz, SCL P1.08,
	 * SDA P1.13. That is ~404 ms for a full 54x42 frame and ~24 ms for the
	 * 12x10 this test ranges at.
	 */

	tof: vl53l9cx@29 {
		compatible = "st,vl53l9cx";
		status = "okay";

		/* 7-bit. ST's 0x52 is the 8-bit form; their own code shifts it
		 * down. See firmware/drivers/vl53l9cx/README.md.
		 */
		reg = <0x29>;

		/* Supply rails, per the datasheet (Victor, 2026-09-04).
		 * vl53l9_init() writes both into the device, and a wrong value
		 * misconfigures the analogue front end rather than failing
		 * loudly — so these being confirmed rather than assumed is what
		 * makes the readings below trustworthy at all.
		 */
		vdda-microvolt = <3300000>;
		vddio-microvolt = <1800000>;

		/* AP_CLK: 8 MHz from the GRTC fast clock output on P0.00,
		 * configured in the board file and running continuously.
		 *
		 * No `pwms` property on purpose. The driver then treats the
		 * clock as board-supplied and does not try to gate it, which is
		 * correct here — see docs/plan/ap-clk-always-on.md.
		 */
		/*
		 * 12 MHz — Victor changed the board's AP_CLK source, 2026-09-11.
		 *
		 * THIS VALUE IS NOT COSMETIC. UM3683 2.5.2: setting it "allows
		 * the firmware to configure all internal clocks required for
		 * correct sensor operation". Declare 8 MHz while feeding 12 and
		 * every internal clock runs 1.5x faster than the firmware
		 * believes — including the one that times the optical pulse
		 * against the blanking period, which 2.6.1 says exists "to
		 * comply with the power limits of laser Class 1".
		 *
		 * The laser driver then trips its own safety interlock and CABDT
		 * reports ERROR_CODE 0x0F00. Which is exactly what the bench
		 * showed from 2026-09-10 onward, and it explains the one fact a
		 * supply theory could not: it faulted even with NB_SHOT_STEP_n
		 * at zero, because a timing violation is wrong on every pulse
		 * however few there are.
		 *
		 * Legal range is 6-27 MHz (Table 11), so 12 MHz is fine — it
		 * simply has to be declared.
		 */
		ext-clock-frequency = <12000000>;

		/*
		 * Sensor power domain, P0.02. Active high.
		 *
		 * This is what gives PM_DEVICE_ACTION_TURN_OFF something to do,
		 * and therefore what the multi-month battery claim rests on. The
		 * driver drops it on TURN_OFF and pays a full 9,865-byte
		 * firmware reload on the next TURN_ON — about 250 ms at 400 kHz,
		 * which is the number the stage-4 crossover is computed from.
		 */
		power-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;

		/*
		 * XSHUT, P1.07. Active high: driven high releases reset.
		 *
		 * Must be ACTIVELY driven — the pin has no internal pull-up. The
		 * device then NAKs for some milliseconds after the rising edge
		 * while its ROM boots, which ST's driver polls through, so the
		 * first NAK is not a failure.
		 */
		xshut-gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>;

		/*
		 * Data-ready interrupt, P0.01. ACTIVE LOW.
		 *
		 * The polarity is not a guess and is not configurable: ST's
		 * hw_config exposes only CMOS versus open-drain
		 * (VL53L9_REGADDR_INTR_OUTPUT_MODE), with no polarity field, and
		 * the hardware-validated community driver states plainly that
		 * INTR is active-low. The driver arms GPIO_INT_EDGE_TO_ACTIVE,
		 * so this is a falling edge.
		 *
		 * With this wired the driver waits on the interrupt instead of
		 * polling frame-ready, which stops the CPU spinning through the
		 * sensor's integration time — the exact energy this design
		 * exists to avoid spending.
		 *
		 * If captures start timing out at exactly the 2 s timeout while
		 * everything else looks healthy, suspect this line before
		 * suspecting the sensor: a missed interrupt and a dead sensor
		 * look identical from the application.
		 */
		/*
		 * GPIO_PULL_UP added 2026-09-07.
		 *
		 * The pin is an active-low CMOS push-pull output on the sensor
		 * side, so a weak pull-up is the correct resting level and
		 * cannot fight the driver. Without it the line FLOATS whenever
		 * the sensor is unpowered or has not yet been told to drive its
		 * interrupt pad - which is the entire window during bring-up,
		 * and the driver arms an edge interrupt on it before any of
		 * that. A floating CMOS input near threshold both invents edges
		 * and draws through-current, on a board whose whole point is a
		 * multi-month battery figure.
		 */
		int-gpios = <&gpio0 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;

		/* Bytes per I2C write during the 9,865-byte blob upload. */
		blob-chunk-size = <1024>;
	};
};

/* ---------------------------------------------------------------------------
 * AP_CLK IS NOT THE MCU'S JOB ANY MORE. Victor, 2026-09-11.
 *
 * The board carries its own 12 MHz oscillator, so every trace of the SoC
 * driving P0.00 is gone: the clock output, the pin routing, and the high-drive
 * pinctrl groups that existed to square up its edges.
 *
 * TWO REASONS, and the second is the one that matters today.
 *
 * ELECTRICAL. An external oscillator and a GRTC output on the same net is two
 * drivers fighting over P0.00. Nothing in software reports that; it shows up as
 * a clock that is neither one frequency nor the other, or as a dead pin.
 *
 * THE RADIO. The GRTC is not merely a clock output — it is this SoC's system
 * timer, and MPSL uses it for radio event timing. Keeping the fast-clock output
 * alive meant holding the SYSCOUNTER ACTIVE permanently, and with
 * VL53L9CX_HOLD_HFCLK the high-frequency domain along with it. Both are
 * resources the Bluetooth controller manages for itself. For a clock the board
 * already supplies, that is contention bought for nothing.
 *
 * P0.00 is left UNCONFIGURED, which on this SoC means input with no pull —
 * high-impedance, so the oscillator drives its net alone.
 *
 * TO PUT IT BACK, if AP_CLK is ever sourced from the SoC again: restore
 * clkout-fast-frequency-hz and the pinctrl properties. Note that GRTC cannot
 * produce 12 MHz at all — it divides the 16 MHz pclk and 8 MHz is its maximum,
 * at divider 1 — so the sensor's ext-clock-frequency would have to change too.
 * -------------------------------------------------------------------------*/

/*
 * The clock-control device, which the SoC dtsi ships disabled.
 *
 * It was enabled so the driver could hold the high-frequency clock on for the
 * GRTC output. That output is gone and the driver no longer touches the HF
 * domain at all.
 *
 * It stays enabled for one reason: app_ble_init() uses it to ask whether the
 * 32 MHz crystal starts. BLE is the only thing on this board that needs HFXO —
 * the CPU runs from internal oscillators — so that check is the difference
 * between "the radio is silent" and "the radio has no clock".
 */
/* ---------------------------------------------------------------------------
 * HFXO / LFXO LOAD CAPACITANCE — AN EXPERIMENT, AND THE VALUES ARE UNVERIFIED.
 *
 * *** THE NUMBERS BELOW ARE NORDIC'S, NOT INSIGHT SiP'S. They are 15000 and
 * *** 17000 femtofarad from zephyr/boards/nordic/nrf54l15dk/
 * *** nrf54l_05_10_15_cpuapp_common.dtsi:34-42, which describes the DK's
 * *** discrete crystals, NOT the ones integrated in the ISP2454-LX. The
 * *** correct figures are Insight SiP's to state and are still VERIFY. Do not
 * *** quote these anywhere, and do not let them become a fact by sitting here.
 *
 * WHY THIS IS WORTH TRYING ANYWAY. It is the only hypothesis that explains
 * every observation from 2026-09-11 at once:
 *
 *   - HFXO STARTS. The boot check confirms it.
 *   - RECEIVE WORKS. 77-89 advertisements heard at -40 dBm.
 *   - TRANSMIT IS INVISIBLE. Chrome filtered, Chrome unfiltered, and nRF
 *     Connect on a phone at close range all see nothing, while the host
 *     reports -EALREADY and the controller reports 0 dBm TX power.
 *
 * The resolution is that RX and TX do NOT have the same frequency tolerance in
 * practice. Our receiver has automatic frequency control and pulls in a carrier
 * that is well off nominal; the advertising packets we TRANSMIT get no such
 * help, and a scanner simply will not demodulate a carrier far enough outside
 * the 1 MHz advertising channel. A crystal running with no load capacitance
 * sits high by a long way - hundreds of ppm is ordinary - which is exactly the
 * asymmetry observed.
 *
 * Zephyr leaves XOSC32MCAPS disabled when no load-capacitors property is
 * present, so today this board runs both crystals with no internal load at all.
 * Nordic's own board sets them; ours never has.
 *
 * HOW TO READ THE RESULT, and the boot self-test does the work:
 *
 *   TX now visible               -> this was it. Get the real numbers from
 *                                   Insight SiP and replace these.
 *   RX self-test gets WORSE      -> the module already has its own load
 *     (fewer packets, or none)      capacitors and this ADDS to them. Delete
 *                                   this block; the answer is elsewhere.
 *   nothing changes at all       -> load capacitance is not the variable.
 *                                   Delete this block and say so.
 *
 * Cheap to try, immediately self-checking, and trivially reversible - which is
 * the only reason unverified numbers are allowed anywhere near this repo.
 * -------------------------------------------------------------------------*/
&hfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <15000>;
};

&lfxo {
	load-capacitors = "internal";
	load-capacitance-femtofarad = <17000>;
};

&clock {
	status = "okay";
};

&grtc {
	/delete-property/ clkout-fast-frequency-hz;

	/* Remove the ROUTING as well as the clock. The board file points
	 * P0.00 at GRTC_CLKOUT_FAST; leaving that in place would hand the pad
	 * back to the GRTC the moment anything re-enabled the output.
	 */
	/delete-property/ pinctrl-0;
	/delete-property/ pinctrl-1;
	/delete-property/ pinctrl-names;
};
