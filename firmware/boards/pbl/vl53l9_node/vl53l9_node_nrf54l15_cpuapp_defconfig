#
# Board defaults. Only what the BOARD implies — application choices belong in
# the app's prj.conf, not here.

CONFIG_GPIO=y
CONFIG_PINCTRL=y

# Console. Bring-up only: a UART held enabled is not free, and this project
# reports energy. Turn it off for the battery measurements.
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
