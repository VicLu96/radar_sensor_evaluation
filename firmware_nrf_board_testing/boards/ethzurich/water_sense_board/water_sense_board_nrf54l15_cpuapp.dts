/*
 * Water sense board — ISP2454-LX (Nordic nRF54L15) + VL53L9CX + SD card.
 *
 * Migrated 2026-09-04 from Victor's hardware-model-v1 board file, for nRF
 * Connect SDK v3.3. The original is recoverable at commit ec65298.
 *
 * ---------------------------------------------------------------------------
 * WHAT SURVIVED UNCHANGED: every pin Victor assigned, the ADC configuration,
 * the BT_CTLR default, and the intent of the SPI/SD arrangement.
 *
 * WHAT CHANGED, and why:
 *   - hardware model v1 -> v2 (the reason nothing built under NCS 3.3)
 *   - nrf54L15_M33.dtsi -> nrf54l15_cpuapp.dtsi, and the SoC symbol with it
 *   - flash0/sram0 -> cpuapp_rram/cpuapp_sram; the nRF54L15 has RRAM
 *   - partitions resized from 512 KB to the full 1428 KB, MCUboot dropped
 *   - gpio1 and gpio2 enabled (where the pins actually are), gpio0 too
 *   - AP_CLK: added, then DISABLED — P0.13 does not exist on this SoC
 *   - RTT console added, so the board can say something
 *   - sdhc0 disabled pending the chip-select decision — see the note on it
 *
 * PERIPHERAL INSTANCE NAMES ARE THE REMAINING GUESS. The nRF54L15 numbers by
 * power domain. i2c21 and spi20 below are chosen to match the pin domains
 * (P1 -> 20-series, P2 -> the fast domain), but if the build says a node does
 * not exist, diff against zephyr/boards/nordic/nrf54l15dk/ in the installed
 * SDK — that is the authority, and it settles every name here at once.
 * ---------------------------------------------------------------------------
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;

#include <nordic/nrf54l15_cpuapp.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include "water_sense_board_nrf54l15_cpuapp-pinctrl.dtsi"

/ {
	model = "water_tracker";
	compatible = "ethzurich,water_tracker";

	chosen {
		zephyr,sram = &cpuapp_sram;
		zephyr,flash = &cpuapp_rram;

		/*
		 * Console over SEGGER RTT, not a UART.
		 *
		 * No UART pins are assigned on this board and the pin budget is
		 * already committed, so RTT costs nothing and works over the
		 * J-Link that is attached anyway. Swap for a UART later if the
		 * pins appear.
		 *
		 * NO zephyr,code-partition: without MCUboot in the build it
		 * would link the image at a bootloader offset the chip never
		 * jumps to, which looks exactly like a dead board. Add it back
		 * together with sysbuild and MCUboot, not before.
		 */
	};

	aliases {
		/*
		 * watchdog0 = &wdt0 was in the original and is dropped: wdt0
		 * does not exist on this SoC (the instances are numbered by
		 * domain, wdt30/wdt31). Nothing referenced it. Re-add pointing
		 * at the real instance if a watchdog is wanted.
		 */
	};

	zephyr,user {
		io-channels = <&adc 0>;
	};
};

/* ---------------------------------------------------------------------------
 * Memory. 1428 KB is what the application core actually has — the remainder of
 * the nRF54L15's RRAM is reserved for the FLPR core. The previous table mapped
 * 512 KB of it and left the other two thirds stranded.
 *
 * No bootloader here, so the application gets everything up to the storage
 * area. Adding MCUboot later is a partition change and a rebuild, not a
 * redesign — the four-partition layout is in
 * docs/hardware/water-sense-board-review.md.
 * -------------------------------------------------------------------------*/
&cpuapp_rram {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		slot0_partition: partition@0 {
			label = "image-0";
			reg = <0x00000000 DT_SIZE_K(1400)>;
		};

		storage_partition: partition@15e000 {
			label = "storage";
			reg = <0x0015e000 DT_SIZE_K(28)>;
		};
	};
};

/* All three ports enabled.
 *
 * The original enabled gpio0 and left gpio1 and gpio2 off, which is where the
 * bus pins are. Pinctrl does not need the GPIO driver, but a software-driven
 * pin does — and chip select on P0.00 is software-driven here, so gpio0 turns
 * out to have been the one that was needed all along.
 */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpiote20 {
	status = "okay";
};

&gpiote30 {
	status = "okay";
};

/* ---------------------------------------------------------------------------
 * AP_CLK for the VL53L9CX — DISABLED, because P0.13 does not exist.
 *
 * Checked against the SDK rather than assumed:
 *   nrf54l_05_10_15.dtsi  gpio0 ngpios = <7>    -> P0.00 .. P0.06
 *                         gpio1 ngpios = <16>   -> P1.00 .. P1.15
 *                         gpio2 ngpios = <11>   -> P2.00 .. P2.10
 *
 * So P0.13 is not a pin on this SoC. CS on P0.00 is fine; AP_CLK on P0.13 is
 * not. It is almost certainly an ISP2454-LX MODULE pin number that needs
 * translating to a SoC port.pin.
 *
 * AND THIS WOULD NOT HAVE FAILED LOUDLY. NRF_PSEL() just encodes port and pin
 * into an integer — nothing validates that the pin exists. The build would
 * have succeeded and the PSEL register would have selected nothing, giving a
 * silent dead clock and a sensor that never acknowledges its address. That is
 * the single most expensive failure mode this project has, so the node is
 * disabled rather than left hopeful.
 *
 * A second constraint, from Nordic's own boards: PWM_OUT never appears on port
 * 0 anywhere in the tree, and P0 carries only uart30 and GRTC pin functions.
 * P0 belongs to the 30 power domain; pwm20/21/22 are 20-domain parts and reach
 * P1 and P2. So even a valid P0 pin could not be driven by this PWM.
 *
 * TWO WAYS FORWARD, and Victor picks:
 *
 *   (a) Put AP_CLK on a free P1 or P2 pin and re-enable this node. Free right
 *       now: P2.05 (released when CS moved to P0.00), and whatever P1/P2 pins
 *       the schematic has spare.
 *
 *   (b) Better, if the routing allows: use the GRTC fast clock output rather
 *       than PWM. It is a purpose-built clock output, and the binding's own
 *       example is literally `clkout-fast-frequency-hz = <8000000>` — our
 *       exact frequency, with none of the COUNTERTOP-of-2 risk that makes
 *       8 MHz marginal on a PWM. Nordic's DK routes GRTC_CLKOUT_FAST to P1.08.
 * -------------------------------------------------------------------------*/
&pwm20 {
	status = "disabled";
	pinctrl-0 = <&pwm_apclk_default>;
	pinctrl-1 = <&pwm_apclk_sleep>;
	pinctrl-names = "default", "sleep";
};

/* I2C: SCL P1.08, SDA P1.13. Instance renamed from i2c1, which does not exist
 * on this SoC.
 *
 * 400 kHz rather than the default 100 kHz: a full 54x42 VL53L9CX frame is
 * 14,842 bytes, which is ~404 ms at 400 kHz and ~1.6 s at 100 kHz.
 *
 * If the board has no external pull-ups on SDA/SCL, add bias-pull-up to the
 * pinctrl group — it is silent either way until the bus does not work.
 */
&i2c21 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	clock-frequency = <I2C_BITRATE_FAST>;

	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";

	/* The VL53L9CX node is NOT here on purpose. It belongs in an
	 * application-level overlay, so this board file stays about the board
	 * and the sensor's configuration travels with the application that
	 * uses it.
	 */
};

/* SPI to the SD card: SCK P2.01, MOSI/SDI P2.04, MISO/SDO P2.02.
 * Instance renamed from spi2, which does not exist on this SoC.
 */
&spi20 {
	status = "okay";
	pinctrl-0 = <&spi2_default>;
	pinctrl-1 = <&spi2_sleep>;
	pinctrl-names = "default", "sleep";

	/*
	 * DISABLED PENDING A DECISION, not deleted.
	 *
	 * Chip select on P0.00 is driven in software from the port file. This
	 * node is Zephyr's SD-over-SPI stack, and `reg = <0>` means "SPI device
	 * 0" — it expects the controller's cs-gpios[0] to exist and drives it
	 * around every transfer. The two cannot both own the pin: manual
	 * toggling underneath Zephyr's produces glitches that read as card
	 * timeouts.
	 *
	 * So, one or the other:
	 *   - Zephyr's stack: add `cs-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;` to
	 *     this node's parent and set status = "okay" here.
	 *   - Port file owns CS: delete this node and talk to the card with raw
	 *     SPI transactions.
	 *
	 * Left disabled so the board builds and boots either way, and so the SD
	 * path cannot fail confusingly at runtime before the decision is made.
	 */
	sdhc0: sdhc@0 {
		status = "disabled";
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		power-delay-ms = <500>;
		spi-max-frequency = <24000000>;
		mmc {
			/* disk-name is REQUIRED by zephyr,sdmmc-disk and was
			 * missing. This is what stopped the build, and it
			 * predates the migration — the original board file had
			 * the same gap, so it would have failed on any SDK.
			 * Note the parent is disabled but this child was not,
			 * and devicetree validates any node that is enabled.
			 */
			status = "disabled";
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
		};
	};
};

/* ADC — carried over from the original unchanged.
 * VERIFY that NRF_SAADC_AIN2 / AIN4 still name the intended pins: the nRF54L
 * family has its own SAADC input bindings and the numbering is not always the
 * same as earlier nRF parts.
 */
&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 5)>;
		zephyr,input-positive = <NRF_SAADC_AIN2>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 5)>;
		zephyr,input-positive = <NRF_SAADC_AIN4>;
		zephyr,resolution = <12>;
		zephyr,oversampling = <4>;
	};
};
